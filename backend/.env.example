# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Stainless Steel Bottle Manufacturing ERP"
APP_ENV=dev                       # dev | test | uat | prod
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-a-long-random-string

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ssberp
DB_USER=ssberp
DB_PASSWORD=ssberp
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── JWT / Auth ─────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=12
PERMISSION_CACHE_SECONDS=60

# ─── Security ───────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=10
PASSWORD_HISTORY_COUNT=5
PASSWORD_MAX_AGE_DAYS=90
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
SESSION_IDLE_MINUTES=30
FIELD_ENCRYPTION_KEY=32-byte-urlsafe-base64-key-here==

# ─── Object storage (S3 / MinIO) ────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ssberp
S3_REGION=us-east-1
MAX_UPLOAD_MB=25

# ─── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM="SSB ERP <noreply@ssberp.local>"

# ─── SMS / WhatsApp (adapters; mock in dev) ─────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
